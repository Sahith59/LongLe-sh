{
  "name": "@longleash/daemon",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude \"test/contract/**\"",
    "demo": "tsx demo/eventlog-demo.ts",
    "demo:auth": "tsx demo/auth-demo.ts",
    "demo:stream": "tsx demo/stream-demo.ts",
    "demo:approve": "tsx demo/approve-demo.ts",
    "test:contract": "LONGLEASH_CONTRACT=1 vitest run test/contract --testTimeout=180000",
    "demo:live": "tsx demo/live-demo.ts",
    "start": "tsx bin/longleashd.ts",
    "demo:relay": "tsx demo/relay-e2e.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.3.0",
    "@longleash/protocol": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.11.0",
    "qrcode-terminal": "^0.12.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@longleash/relay": "workspace:*",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "jsqr": "^1.4.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
