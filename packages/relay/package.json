{
  "name": "@longleash/relay",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx bin/longleash-relay.ts",
    "typecheck": "wrangler types --env-interface Env --check && tsc --noEmit",
    "test": "vitest run",
    "dev:worker": "wrangler dev",
    "dev:selfhost": "wrangler dev --config wrangler.selfhost.jsonc",
    "deploy:worker": "wrangler deploy",
    "deploy:selfhost": "pnpm --filter @longleash/app build && wrangler deploy --config wrangler.selfhost.jsonc",
    "check:selfhost": "pnpm --filter @longleash/app build && wrangler deploy --config wrangler.selfhost.jsonc --dry-run",
    "cf-typegen": "wrangler types --env-interface Env"
  },
  "dependencies": {
    "@clerk/backend": "3.16.6",
    "tsx": "^4.23.1",
    "ws": "^8.21.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.123.0"
  }
}
