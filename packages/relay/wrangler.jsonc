{
  // The free-forever deployment: `pnpm --filter @longleash/relay deploy:worker`.
  // Durable Objects on the Workers free plan cover a personal relay many times over
  // (100k requests/day), need no credit card, and cannot run out of capacity.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "longleash-relay",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "observability": { "enabled": true },

  // The built app shell. Requests for it never reach the Worker, so they cost nothing.
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    // Deep links must land in the app rather than a 404.
    "not_found_handling": "single-page-application"
  },

  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },

  // SQLite-backed classes are the ones available on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
