{
  "name": "longleash",
  "private": true,
  "version": "0.0.1",
  "description": "Control the AI-agent, terminal, and IDE sessions on your laptop from your phone \u2014 anywhere.",
  "license": "MIT",
  "repository": "github:Sahith59/LongLe-sh",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "cli:verify-package": "pnpm --filter @longleash/cli build && pnpm --filter @longleash/cli pack:verify",
    "verify:production": "node scripts/verify-production.mjs",
    "vscode:package": "pnpm --dir packages/vscode package:vsix",
    "vscode:verify-package": "pnpm --dir packages/vscode package:verify",
    "vscode:install": "pnpm --dir packages/vscode install:local"
  },
  "pnpm": {
    "overrides": {
      "hono": "4.13.2"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.33.2"
}
